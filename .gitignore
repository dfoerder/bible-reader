.env
*.bak
*.swp
.DS_Store
node_modules/
ios/
www/

# Logs
*.log

# Transienter Batch-/Lauf-Status
batch_state.json
modernize_batch_state.json

# Backups abgeleiteter Daten
data/*_backup.json

# Build-Intermediates der Trainingsdaten — von generate_training_data.js erzeugt,
# zu words.json zusammengeführt (Single Source of Truth). Nur words.json wird versioniert.
# Trainingsdaten liegen pro Bibel unter bibles/<edition>/train/.
bibles/*/*/train/vocab_pool.json
bibles/*/*/train/context_exercises.json

# Claude-Harness
.claude/

# Icon-Arbeitsdateien (GIMP-Quelle, Zwischenstände)
*.xcf
*.alt

# Große externe Datenquellen (lokal vorhalten, nicht versionieren)
EFLLex.tsv
oxford_5000.csv

# Legacy-Datenblobs in alt/ — lokal als Provenienz behalten, nicht versionieren
# (Skripte in alt/ bleiben getrackt)
alt/*.json
alt/*.xml

# Einmalige History-Bereinigung (Maintenance-Artefakte, nicht versionieren)
rewrite_history.sh
purge_paths.txt
